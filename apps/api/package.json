{
  "name": "@greensteps/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/connection.test.js dist/test/database.test.js",
    "db:generate": "node ../../scripts/prisma.mjs generate",
    "db:validate": "node ../../scripts/prisma.mjs validate",
    "db:deploy": "node ../../scripts/prisma.mjs migrate deploy",
    "db:status": "node ../../scripts/prisma.mjs migrate status",
    "db:seed": "node ../../scripts/prisma.mjs db seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "prisma": "7.10.1",
    "tsx": "^4.21.0"
  }
}
