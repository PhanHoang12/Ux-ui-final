PORT=3000
DB_POOL_MAX=5
DATABASE_URL=postgresql://greensteps:YOUR_POSTGRES_PASSWORD@localhost:5433/greensteps
CORS_ORIGINS=http://localhost:8081

# Run npm run setup:local to generate this locally. Never commit a real secret.
# AUTH_SECRET=your-random-secret-of-at-least-32-characters
# SMTP settings from your email provider; use its app password/API SMTP credential.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=GreenSteps <your-email@gmail.com>
